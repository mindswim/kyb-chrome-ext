{
  "manifest_version": 3,
  "name": "KYB Check (concept demo)",
  "version": "0.1.0",
  "description": "Business verification in your side panel. Candidate concept demo - not affiliated with Middesk.",
  "action": {
    "default_title": "KYB Check"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.middesk.com/*"]
}
