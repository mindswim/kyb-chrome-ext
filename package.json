{
  "name": "kyb-chrome-ext",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Concept demo: a Chrome side-panel that shows a public-record snapshot of the business behind the site you're on, in Middesk's design language.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --config vite.demo.config.ts",
    "preview": "vite preview",
    "preview:demo": "vite preview --config vite.demo.config.ts --port 4174 --strictPort",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,css,json}\" \"*.{ts,md,json,html}\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
